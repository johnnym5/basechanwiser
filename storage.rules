rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Match user-specific folders
    match /documents/{userId}/{fileName} {
      // Allow the specific user to read and write their own files
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Allow admins and counselors to read (assuming you enforce this strictly on the frontend,
      // or you can leave read open to all authenticated users if acceptable)
      allow read: if request.auth != null;
    }

    // Match the mock interviews from the previous step
    match /mock_interviews/{fileName} {
      allow read, write: if request.auth != null;
    }
  }
}
