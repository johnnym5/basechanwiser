rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // 🛡️ REBUST STAFF CHECK (Dependent on Firestore)
    function isStaff() {
      return request.auth != null &&
        (firestore.get(/databases/(default)/documents/Users/$(request.auth.uid)).data.role == 'Counselor' ||
         firestore.get(/databases/(default)/documents/Users/$(request.auth.uid)).data.role == 'Admin' ||
         firestore.get(/databases/(default)/documents/Users/$(request.auth.uid)).data.role == 'Super Admin');
    }

    // 🛡️ EMERGENCY ADMIN BYPASS (Email based - Resilient to Billing/Firestore Lock)
    function isSystemRoot() {
      return request.auth != null && (
        request.auth.token.email == 'jegbase@gmail.com' ||
        request.auth.token.email == 'ithub@basechaninternational.com'
      );
    }

    // Standard Rule: Authenticated users can read all
    match /{allPaths=**} {
      allow read: if request.auth != null;
    }

    // 1. Library Assets: Only Counselors/Admins
    match /library/{allPaths=**} {
      allow write: if isSystemRoot() || isStaff();
    }

    // 2. Branding Assets
    match /branding/{allPaths=**} {
      allow write: if isSystemRoot() || isStaff();
    }

    // 3. Mock Interviews: Student Ownership + Staff Override
    match /mock_interviews/{userId}/{allPaths=**} {
      allow write: if (request.auth != null && request.auth.uid == userId) || isSystemRoot() || isStaff();
    }

    // 4. Student Documents: Student Ownership + Staff Override
    match /documents/{userId}/{allPaths=**} {
      allow write: if (request.auth != null && request.auth.uid == userId) || isSystemRoot() || isStaff();
    }

    // 5. Student Packs: Student Ownership + Staff Override
    match /student_packs/{userId}/{allPaths=**} {
      allow write: if (request.auth != null && request.auth.uid == userId) || isSystemRoot() || isStaff();
    }

    // Global Fallback for Writes
    match /{allPaths=**} {
      allow write: if isSystemRoot() || isStaff();
    }
  }
}
