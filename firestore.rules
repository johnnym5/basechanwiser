rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper Functions ───────────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Returns the role of the authenticated user from the Users collection
    function getUserData() {
      return get(/databases/$(database)/documents/Users/$(request.auth.uid)).data;
    }

    function isSuperAdmin() {
      return isAuthenticated() && getUserData().role == 'Super Admin';
    }

    function isAdmin() {
      return isAuthenticated() && (getUserData().role == 'Admin' || getUserData().role == 'Super Admin');
    }

    function isStaff() {
      return isAuthenticated() && (getUserData().role == 'Admin' || getUserData().role == 'Super Admin' || getUserData().role == 'Counselor');
    }

    // ─── Users Collection ───────────────────────────────────────────
    match /Users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // ─── Question Packs ─────────────────────────────────────────────
    match /question_packs/{packId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isStaff();
    }

    // ─── Learning Modules (Progressive Track) ───────────────────────
    match /learning_modules/{moduleId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    // ─── Student Progress ───────────────────────────────────────────
    match /Progress/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId) || isStaff();
    }

    // ─── Interview Packs ────────────────────────────────────────────
    match /Interview_Packs/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId) || isStaff();
    }

    // ─── Junior Evaluations ─────────────────────────────────────────
    match /Junior_Evaluations/{evalId} {
      allow read: if isAuthenticated();
      allow write: if isStaff();
    }

    // ─── Library Resources ──────────────────────────────────────────
    match /library_resources/{resourceId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isStaff();
    }

    // ─── Reminders ─────────────────────────────────────────────────
    match /reminders/{reminderId} {
      allow read: if isAuthenticated() && resource.data.counselorUid == request.auth.uid;
      allow create: if isStaff()
        && request.auth.uid == request.resource.data.counselorUid
        && request.resource.data.isTriggered == false
        && request.resource.data.studentUid is string
        && request.resource.data.studentId is string
        && request.resource.data.message is string
        && request.resource.data.triggerAt is int;
      allow update, delete: if isStaff() && resource.data.counselorUid == request.auth.uid;
    }

    // ─── Notifications ──────────────────────────────────────────────
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isStaff()
        && request.resource.data.userId is string
        && request.resource.data.title is string
        && request.resource.data.message is string
        && request.resource.data.isRead is bool
        && request.resource.data.link is string
        && request.resource.data.createdAt is timestamp;
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow delete: if isAdmin();
    }

    // ─── Resources (Legacy) ─────────────────────────────────────────
    match /resources/{resourceId} {
      allow read: if isAuthenticated();
      allow write: if isStaff();
    }

    // ─── System Settings ────────────────────────────────────────────
    match /system_settings/{docId} {
      allow read: if true; // Publicly readable for maintenance mode check
      allow write: if isAdmin();
    }

    // ─── AI Rate Limits (server-side) ──────────────────────────────
    match /ai_rate_limits/{userId} {
      allow read, write: if isOwner(userId);
    }

    // ─── Interview Evaluations ─────────────────────────────────────
    match /interview_evaluations/{evalId} {
      allow read: if isAuthenticated();
      allow create: if isStaff();
      allow update, delete: if isAdmin();
    }

    // ─── Quiz Attempts ──────────────────────────────────────────────
    match /quiz_attempts/{attemptId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }
  }
}
