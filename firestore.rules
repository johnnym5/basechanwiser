rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for multi-tenant isolation & authentication checks
    function isAuthenticated() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isAuthenticated() && request.auth.token.role == 'SUPER_ADMIN';
    }

    function belongsToOrg(orgId) {
      return isAuthenticated() && request.auth.token.orgId == orgId;
    }

    function isDocInUserOrg() {
      return isAuthenticated() && request.auth.token.orgId == resource.data.organizationId;
    }

    // Organization Collection Rules
    match /organizations/{orgId} {
      allow read: if isAuthenticated() && (isSuperAdmin() || belongsToOrg(orgId));
      allow write: if isSuperAdmin();
    }

    // Users Collection Rules
    match /users/{userId} {
      allow read: if isAuthenticated() && (isSuperAdmin() || request.auth.token.orgId == resource.data.organizationId);
      allow write: if isSuperAdmin() || (belongsToOrg(request.resource.data.organizationId) && request.auth.token.role == 'ORG_ADMIN');
    }

    // Attendance Collection Rules
    match /attendance/{attendanceId} {
      allow read: if isDocInUserOrg();
      allow create: if isAuthenticated() && request.resource.data.organizationId == request.auth.token.orgId;
      allow update: if isDocInUserOrg() && (
        request.auth.token.role in ['HR_MANAGER', 'ORG_ADMIN', 'SUPER_ADMIN'] ||
        resource.data.userId == request.auth.uid
      );
    }

    // Financial Requisitions Collection Rules
    match /requisitions/{reqId} {
      allow read: if isDocInUserOrg();
      allow create: if isAuthenticated() && request.resource.data.organizationId == request.auth.token.orgId;
      allow update: if isDocInUserOrg() && (
        resource.data.applicantId == request.auth.uid ||
        request.auth.token.role in ['HR_MANAGER', 'FINANCE_MANAGER', 'MD', 'ORG_ADMIN', 'SUPER_ADMIN']
      );
    }

    // Tasks Collection Rules
    match /tasks/{taskId} {
      allow read, write: if isAuthenticated() && (
        (resource == null && request.resource.data.organizationId == request.auth.token.orgId) ||
        isDocInUserOrg()
      );
    }

    // Workbooks Collection Rules
    match /workbooks/{workbookId} {
      allow read, write: if isAuthenticated() && (
        (resource == null && request.resource.data.organizationId == request.auth.token.orgId) ||
        isDocInUserOrg()
      );
    }

    // Messages & Announcements Rules
    match /messages/{messageId} {
      allow read, write: if isAuthenticated() && (
        (resource == null && request.resource.data.organizationId == request.auth.token.orgId) ||
        isDocInUserOrg()
      );
    }

    match /announcements/{announcementId} {
      allow read: if isDocInUserOrg();
      allow create, update: if isAuthenticated() && 
        request.resource.data.organizationId == request.auth.token.orgId &&
        request.auth.token.role in ['HR_MANAGER', 'ORG_ADMIN', 'SUPER_ADMIN'];
    }
  }
}
