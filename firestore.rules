rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper Functions ───────────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // ─── Users Collection ───────────────────────────────────────────
    // Any authenticated user can read the Users collection (needed for
    // the Student Directory, staff listing, etc.).
    // A user can always write to their own document.
    // Staff (Counselors/Admins) can update any student document
    // (e.g. assigning packs, setting readiness status).
    match /Users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId)
                    || (isAuthenticated()
                        && resource.data.role == 'Student');
      allow delete: if false; // only via Admin SDK / console
    }

    // ─── Question Packs ─────────────────────────────────────────────
    // All authenticated users can read packs (students need them for learning).
    // Only authenticated staff can create/update/delete packs.
    match /question_packs/{packId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAuthenticated();
    }

    // ─── Student Progress ───────────────────────────────────────────
    // Users can read/write their own progress document.
    // Staff can read any student's progress.
    match /Progress/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId);
    }

    // ─── Interview Packs ────────────────────────────────────────────
    // Students write their own interview pack; staff can read all.
    match /Interview_Packs/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId);
    }

    // ─── Junior Evaluations ─────────────────────────────────────────
    // Staff can read/write evaluations. Students can read their own.
    match /Junior_Evaluations/{evalId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // ─── Resources (Google Drive links) ─────────────────────────────
    match /resources/{resourceId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // ─── System Settings ────────────────────────────────────────────
    match /system_settings/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // ─── AI Rate Limits (server-side, but allow if needed) ──────────
    match /ai_rate_limits/{userId} {
      allow read, write: if isOwner(userId);
    }
  }
}
